#!/usr/bin/env python3
"""Reconstruct and display a Claude Code conversation from session JSONL files.

Usage:
  claude-session                  # List all sessions
  claude-session <session-id>     # Show full conversation
  claude-session <session-id> --no-thinking   # Hide thinking blocks
  claude-session <session-id> --no-tools      # Hide tool calls/results
  claude-session <session-id> --compact        # Hide thinking + truncate tool results
  claude-session <session-id> --info           # Session summary
  claude-session -v                            # Include token usage
"""

import json
import os
import sys
import glob
import shutil
import signal
import textwrap
import time
from collections import Counter, defaultdict
from datetime import datetime


# Claude Code's data directory; honors CLAUDE_CONFIG_DIR like Claude Code does.
CLAUDE_DIR = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")
PROJECTS_DIR = os.path.join(CLAUDE_DIR, "projects")


def parse_timestamp(ts):
    """Parse a timestamp (numeric epoch or ISO string) to epoch seconds."""
    if ts is None:
        return None
    if isinstance(ts, (int, float)):
        return ts / 1000 if ts > 1e12 else ts
    if isinstance(ts, str):
        for fmt in ("%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
            try:
                dt = datetime.strptime(ts, fmt)
                return dt.timestamp()
            except ValueError:
                continue
        # Fallback: try just the date
        try:
            return datetime.strptime(ts[:10], "%Y-%m-%d").timestamp()
        except ValueError:
            pass
    return None


def format_time(ts):
    """Format a raw timestamp value to a display string."""
    epoch = parse_timestamp(ts)
    if epoch is None:
        return ""
    try:
        return datetime.fromtimestamp(epoch).strftime("%Y-%m-%d %H:%M:%S")
    except (OSError, ValueError):
        return ""


# Terminal colors. Enabled only when stdout is a terminal and NO_COLOR is
# unset (https://no-color.org); --color / --no-color override.
COLORS = {
    "RESET": "\033[0m",
    "BOLD": "\033[1m",
    "DIM": "\033[2m",
    "USER_COLOR": "\033[1;34m",         # Bold blue
    "ASSISTANT_COLOR": "\033[1;32m",    # Bold green
    "THINKING_COLOR": "\033[2;35m",     # Dim magenta
    "TOOL_COLOR": "\033[0;33m",         # Yellow
    "TOOL_RESULT_COLOR": "\033[2;33m",  # Dim yellow
    "ERROR_COLOR": "\033[0;31m",        # Red
    "SEPARATOR_COLOR": "\033[2;37m",    # Dim gray
}


def set_color(enabled):
    """Define the color globals as escape codes, or as empty strings."""
    for name, code in COLORS.items():
        globals()[name] = code if enabled else ""


set_color(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))


def project_display_name(path):
    """Derive a short project name from a session file path."""
    rel = os.path.relpath(os.path.abspath(path), PROJECTS_DIR)
    if rel.split(os.sep)[0] == os.pardir:
        # Outside the Claude data dir (e.g. a copied transcript): the encoded
        # project name is the directory holding the file (for subagents,
        # <project>/<session>/subagents/x.jsonl, it is three levels up).
        parts = os.path.abspath(path).split(os.sep)
        project = parts[-4] if len(parts) >= 4 and parts[-2] == "subagents" else parts[-2]
    else:
        project = rel.split(os.sep)[0]
    home_prefix = os.path.expanduser("~").replace("/", "-")
    for prefix, repl in ((home_prefix + "-projects-", ""), (home_prefix + "-", "~/")):
        if project.startswith(prefix):
            project = repl + project[len(prefix):]
            break
    # <repo>/.claude/worktrees/<name> -> <repo>:<name>
    return project.replace("--claude-worktrees-", ":")


def extract_user_text(content):
    """Return the human-typed text of a user message, or '' if it isn't one.

    Skips tool results, slash-command wrappers, and other injected content.
    """
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = []
        for b in content:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_result":
                return ""
            if b.get("type") == "text":
                parts.append(b.get("text", ""))
        text = "\n".join(parts)
    else:
        return ""
    text = text.strip()
    if not text or text.startswith("<") or text.startswith("[Request interrupted"):
        return ""
    return text


def remote_session_id(entry):
    """Return the remote-control session ID ('session_...') an entry records, or ''.

    Remote Control sessions log a bridge-session entry with bridgeSessionId
    'cse_<X>' and a bridge_status entry with URL .../code/session_<X>; both
    name the same claude.ai session, which the UI and URLs call 'session_<X>'.
    """
    etype = entry.get("type")
    if etype == "bridge-session":
        bid = entry.get("bridgeSessionId") or ""
        if bid.startswith("cse_"):
            return "session_" + bid[len("cse_"):]
        return bid
    if etype == "system" and entry.get("subtype") == "bridge_status":
        url = entry.get("url") or ""
        tail = url.rstrip("/").rsplit("/", 1)[-1]
        if tail.startswith("session_"):
            return tail
    return ""


def scan_session(path):
    """Read a session file once and collect metadata and usage."""
    stat = os.stat(path)
    info = {
        "path": path,
        "session_id": os.path.basename(path)[:-len(".jsonl")],
        "project": project_display_name(path),
        "lines": 0,
        "first_ts": None,
        "last_ts": None,
        "first_msg": "",
        "custom_title": "",
        "remote_ids": [],
        "ai_title": "",
        "total_input": 0,
        "total_output": 0,
        "total_cache_read": 0,
        "total_cache_create": 0,
    }
    seen_ids = set()
    with open(path) as f:
        for line in f:
            info["lines"] += 1
            try:
                data = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if not isinstance(data, dict):
                continue
            etype = data.get("type")
            rid = remote_session_id(data)
            if rid and rid not in info["remote_ids"]:
                info["remote_ids"].append(rid)
            if etype == "custom-title" and data.get("customTitle"):
                info["custom_title"] = data["customTitle"]
            elif etype == "ai-title" and data.get("aiTitle"):
                info["ai_title"] = data["aiTitle"]
            ts = parse_timestamp(data.get("timestamp"))
            if ts:
                if not info["first_ts"]:
                    info["first_ts"] = ts
                info["last_ts"] = ts
            msg = data.get("message")
            # Only real transcript entries; api-request-blob etc. also carry
            # a "message" but are request echoes, not conversation turns.
            if etype not in ("user", "assistant") or not isinstance(msg, dict):
                continue
            if msg.get("role") == "user" and not info["first_msg"] and not data.get("isMeta"):
                info["first_msg"] = extract_user_text(msg.get("content", ""))[:200]
            usage = msg.get("usage")
            if usage and msg.get("role") == "assistant":
                # One JSONL line is written per content block, each carrying
                # the same message.id and usage; count each message once.
                mid = msg.get("id")
                if mid:
                    if mid in seen_ids:
                        continue
                    seen_ids.add(mid)
                info["total_input"] += usage.get("input_tokens", 0) or 0
                info["total_output"] += usage.get("output_tokens", 0) or 0
                info["total_cache_read"] += usage.get("cache_read_input_tokens", 0) or 0
                info["total_cache_create"] += usage.get("cache_creation_input_tokens", 0) or 0
    info["first_ts"] = info["first_ts"] or stat.st_mtime
    info["last_ts"] = info["last_ts"] or stat.st_mtime
    info["remote_id"] = info["remote_ids"][-1] if info["remote_ids"] else ""
    info["title"] = info["custom_title"] or info["ai_title"] or info["first_msg"].split("\n")[0]
    return info


def find_sessions(max_age_days=None):
    """Find all session JSONL files with metadata.

    If max_age_days is set, skip files whose mtime is older than that.
    """
    cutoff = None
    if max_age_days is not None:
        cutoff = time.time() - max_age_days * 86400

    sessions = []
    for path in glob.glob(os.path.join(glob.escape(PROJECTS_DIR), "**", "*.jsonl"), recursive=True):
        if "/subagents/" in path:
            continue
        if cutoff is not None and os.stat(path).st_mtime < cutoff:
            continue
        sessions.append(scan_session(path))

    sessions.sort(key=lambda s: s["first_ts"], reverse=True)
    return sessions


def list_sessions(max_age_days=None, verbose=False):
    """Print a table of sessions, optionally filtered by mtime."""
    sessions = find_sessions(max_age_days=max_age_days)
    if not sessions:
        if max_age_days is not None:
            print(f"No sessions updated in the last {max_age_days} day(s).")
            print("Use --all or --days N to widen the window.")
        else:
            print("No sessions found.")
        return

    header = "Claude Code Sessions"
    if max_age_days is not None:
        header += f" (last {max_age_days} day{'s' if max_age_days != 1 else ''})"
    print(f"\n{BOLD}{header}{RESET}\n")

    width = shutil.get_terminal_size((160, 24)).columns
    cols = f"  {'#':<4} {'Session ID':<36}  {'Created':<16}  {'Updated':<16}"
    rule = f"  {'-'*4} {'-'*36}  {'-'*16}  {'-'*16}"
    rid_w = 32  # len("session_") + 24-char ID
    if verbose:
        cols += f"  {'Remote Session':<{rid_w}}"
        rule += f"  {'-'*rid_w}"
        cols += f"  {'Input':>10} {'Output':>10} {'Cache Read':>13} {'Cache Write':>12}"
        rule += f"  {'-'*10} {'-'*10} {'-'*13} {'-'*12}"
    cols += f"  {'Project':<28}  "
    rule += f"  {'-'*28}  "
    title_width = max(20, width - len(cols))
    print(f"{cols}Title")
    print(f"{rule}{'-'*min(title_width, 40)}")

    totals = [0, 0, 0, 0]
    for i, s in enumerate(sessions, 1):
        created = datetime.fromtimestamp(s["first_ts"]).strftime("%Y-%m-%d %H:%M")
        updated = datetime.fromtimestamp(s["last_ts"]).strftime("%Y-%m-%d %H:%M")
        row = f"  {i:<4} {s['session_id']:<36}  {created:<16}  {updated:<16}"
        if verbose:
            row += f"  {(s['remote_id'] or '-'):<{rid_w}}"
            vals = [s["total_input"], s["total_output"], s["total_cache_read"], s["total_cache_create"]]
            totals = [a + b for a, b in zip(totals, vals)]
            row += f"  {vals[0]:>10,} {vals[1]:>10,} {vals[2]:>13,} {vals[3]:>12,}"
        proj = s["project"]
        if len(proj) > 28:
            proj = proj[:27] + "…"
        title = s["title"].replace("\n", " ")
        if len(title) > title_width:
            title = title[:title_width - 1] + "…"
        row += f"  {proj:<28}  {title}"
        print(row)

    if verbose:
        print(f"  {'-'*4} {'-'*36}  {'-'*16}  {'-'*16}  {'-'*rid_w}  {'-'*10} {'-'*10} {'-'*13} {'-'*12}")
        print(f"  {'':4} {'':36}  {'':16}  {'TOTAL':<16}  {'':<{rid_w}}"
              f"  {totals[0]:>10,} {totals[1]:>10,} {totals[2]:>13,} {totals[3]:>12,}")

    print(f"\n  Replay: claude-session <# | id-prefix>    Details: claude-session <# | id-prefix> --info\n")


def format_duration(seconds):
    """Format seconds as e.g. '2h 05m', '7m 12s', '45s'."""
    seconds = int(round(seconds or 0))
    h, rem = divmod(seconds, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m"
    if m:
        return f"{m}m {sec:02d}s"
    return f"{sec}s"


def collect_session_info(path):
    """Gather detailed statistics about a single session."""
    base = scan_session(path)
    info = dict(base)
    cwds = []
    branches = []
    versions = []
    entrypoints = []
    permission_modes = []
    efforts = []
    models = Counter()
    tool_counts = Counter()
    skills = Counter()
    files_modified = []
    pr_links = []
    agent_calls = 0
    tool_errors = 0
    user_prompts = 0
    interruptions = 0
    assistant_msgs = 0
    thinking_tokens = 0
    web_searches = 0
    web_fetches = 0
    active_ms = 0
    compactions = []
    worktree = None
    remote_url = ""
    last_prompt = ""
    seen_ids = set()

    def add_unique(lst, val):
        if val and val not in lst:
            lst.append(val)

    with open(path) as f:
        for line in f:
            try:
                data = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if not isinstance(data, dict):
                continue
            etype = data.get("type")
            add_unique(cwds, data.get("cwd"))
            add_unique(branches, data.get("gitBranch") if data.get("gitBranch") != "HEAD" else None)
            add_unique(versions, data.get("version"))
            add_unique(entrypoints, data.get("entrypoint"))
            add_unique(efforts, data.get("effort"))

            if etype == "permission-mode":
                add_unique(permission_modes, data.get("permissionMode"))
            elif etype == "worktree-state" and isinstance(data.get("worktreeSession"), dict):
                worktree = data["worktreeSession"]
            elif etype == "last-prompt" and data.get("lastPrompt"):
                last_prompt = data["lastPrompt"]
            elif etype == "pr-link" and data.get("prUrl"):
                add_unique(pr_links, data["prUrl"])
            elif etype == "system":
                sub = data.get("subtype")
                if sub == "turn_duration":
                    active_ms += data.get("durationMs", 0) or 0
                elif sub == "compact_boundary":
                    meta = data.get("compactMetadata") or {}
                    compactions.append((meta.get("trigger", "?"), meta.get("preTokens")))
                elif sub == "bridge_status" and data.get("url"):
                    remote_url = data["url"]

            msg = data.get("message")
            # Only real transcript entries; api-request-blob etc. also carry
            # a "message" but are request echoes, not conversation turns.
            if etype not in ("user", "assistant") or not isinstance(msg, dict):
                continue
            content = msg.get("content")
            role = msg.get("role")

            if role == "user":
                if isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_result" and b.get("is_error"):
                            tool_errors += 1
                text = content if isinstance(content, str) else ""
                if isinstance(content, list):
                    text = " ".join(b.get("text", "") for b in content
                                    if isinstance(b, dict) and b.get("type") == "text")
                if text.startswith("[Request interrupted"):
                    interruptions += 1
                elif not data.get("isMeta") and extract_user_text(content):
                    user_prompts += 1

            elif role == "assistant":
                mid = msg.get("id")
                new_msg = not mid or mid not in seen_ids
                if mid:
                    seen_ids.add(mid)
                if new_msg:
                    assistant_msgs += 1
                    if msg.get("model") and msg["model"] != "<synthetic>":
                        models[msg["model"]] += 1
                    usage = msg.get("usage") or {}
                    thinking_tokens += (usage.get("output_tokens_details") or {}).get("thinking_tokens", 0) or 0
                    stu = usage.get("server_tool_use") or {}
                    web_searches += stu.get("web_search_requests", 0) or 0
                    web_fetches += stu.get("web_fetch_requests", 0) or 0
                if isinstance(content, list):
                    for b in content:
                        if not isinstance(b, dict) or b.get("type") != "tool_use":
                            continue
                        name = b.get("name", "unknown")
                        tool_counts[name] += 1
                        inp = b.get("input") or {}
                        if name == "Skill" and inp.get("skill"):
                            skills[inp["skill"]] += 1
                        elif name in ("Agent", "Task"):
                            agent_calls += 1
                        if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                            add_unique(files_modified, inp.get("file_path") or inp.get("notebook_path"))

    subagent_dir = os.path.join(path[:-len(".jsonl")], "subagents")
    subagent_files = sorted(glob.glob(os.path.join(glob.escape(subagent_dir), "*.jsonl"))) if os.path.isdir(subagent_dir) else []

    info.update(
        cwds=cwds, branches=branches, versions=versions, entrypoints=entrypoints,
        permission_modes=permission_modes, efforts=efforts, models=models,
        tool_counts=tool_counts, skills=skills, files_modified=files_modified,
        pr_links=pr_links, agent_calls=agent_calls, tool_errors=tool_errors,
        user_prompts=user_prompts, interruptions=interruptions,
        assistant_msgs=assistant_msgs, thinking_tokens=thinking_tokens,
        web_searches=web_searches, web_fetches=web_fetches, active_ms=active_ms,
        compactions=compactions, worktree=worktree, remote_url=remote_url,
        last_prompt=last_prompt, subagent_files=subagent_files,
    )
    return info


def show_session_info(path, verbose=False):
    """Print a summary of a single session."""
    s = collect_session_info(path)
    label_w = 16

    def row(label, value):
        if value in (None, "", [], 0):
            return
        print(f"  {DIM}{label:<{label_w}}{RESET} {value}")

    def section(name):
        print(f"\n{BOLD}{name}{RESET}")

    print(f"\n{BOLD}Session {s['session_id']}{RESET}")
    print(f"{SEPARATOR_COLOR}{'=' * 80}{RESET}")
    row("Title", s["custom_title"] or s["ai_title"])
    if s["custom_title"] and s["ai_title"] and s["custom_title"] != s["ai_title"]:
        row("AI title", s["ai_title"])
    row("Project", s["project"])
    row("Directory", ", ".join(s["cwds"]))
    row("Git branch", ", ".join(s["branches"]))
    wt = s["worktree"]
    if wt:
        row("Worktree", f"{wt.get('worktreeName', '')} (from {wt.get('originalBranch', '?')} "
                        f"@ {str(wt.get('originalHeadCommit', ''))[:10]})")
    row("Remote session", ", ".join(s["remote_ids"]))
    row("Remote URL", s["remote_url"] or (f"https://claude.ai/code/{s['remote_id']}" if s["remote_id"] else ""))
    row("Session file", s["path"])

    section("Timeline")
    row("Started", format_time(s["first_ts"]))
    row("Last activity", format_time(s["last_ts"]))
    row("Elapsed", format_duration(s["last_ts"] - s["first_ts"]))
    row("Active time", format_duration(s["active_ms"] / 1000) if s["active_ms"] else "")
    row("User prompts", s["user_prompts"])
    row("API responses", s["assistant_msgs"])
    row("Interruptions", s["interruptions"])
    if s["compactions"]:
        parts = [f"{t}" + (f" @ {pt:,} tok" if pt else "") for t, pt in s["compactions"]]
        row("Compactions", f"{len(parts)} ({', '.join(parts)})")

    section("Environment")
    row("Models", ", ".join(f"{m} ({n})" for m, n in s["models"].most_common()))
    row("Effort", ", ".join(s["efforts"]))
    row("Permission mode", ", ".join(s["permission_modes"]))
    row("Entrypoint", ", ".join(s["entrypoints"]))
    row("Claude Code", ", ".join(s["versions"]))

    section("Activity")
    total_tools = sum(s["tool_counts"].values())
    if total_tools:
        top = s["tool_counts"].most_common(None if verbose else 8)
        summary = ", ".join(f"{n} {c}" for n, c in top)
        if not verbose and len(s["tool_counts"]) > 8:
            summary += ", …"
        row("Tool calls", f"{total_tools:,}  ({summary})")
    else:
        row("Tool calls", "none")
    row("Tool errors", s["tool_errors"])
    row("Skills", ", ".join(f"{n} ({c})" for n, c in s["skills"].most_common()))
    row("Subagents", (f"{len(s['subagent_files'])} transcript(s)" if s["subagent_files"]
                      else f"{s['agent_calls']} call(s)") if (s["subagent_files"] or s["agent_calls"]) else "")
    if s["web_searches"] or s["web_fetches"]:
        row("Web", f"{s['web_searches']} search(es), {s['web_fetches']} fetch(es)")
    for i, url in enumerate(s["pr_links"]):
        row("Pull request" if i == 0 else "", url)
    files = s["files_modified"]
    if files:
        row("Files modified", f"{len(files)}")
        shown = files if verbose else files[:10]
        root = s["cwds"][0].rstrip("/") + "/" if s["cwds"] else None
        for fp in shown:
            if root and fp.startswith(root):
                fp = fp[len(root):]
            print(f"  {'':<{label_w}}   {fp}")
        if len(files) > len(shown):
            print(f"  {'':<{label_w}}   {DIM}… {len(files) - len(shown)} more (use -v){RESET}")

    if verbose:
        section("Token usage")
        row("Input", f"{s['total_input']:,}")
        row("Output", f"{s['total_output']:,}")
        row("  thinking", f"{s['thinking_tokens']:,}" if s["thinking_tokens"] else "")
        row("Cache read", f"{s['total_cache_read']:,}")
        row("Cache write", f"{s['total_cache_create']:,}")

    section("Prompts")
    first = s["first_msg"].replace("\n", " ")
    row("First", first[:150] + ("…" if len(first) > 150 else ""))
    last = s["last_prompt"].replace("\n", " ")
    if last and last != s["first_msg"]:
        row("Last", last[:150] + ("…" if len(last) > 150 else ""))

    if s["subagent_files"]:
        section("Subagent transcripts")
        for fp in s["subagent_files"]:
            print(f"  {fp}")
    print()


def find_session_path(identifier, max_age_days=None):
    """Find session path by ID or list number.

    Resolution order:
      - '#N' always means list index N (into the filtered list)
      - Numeric identifier: treat as list index into the filtered list
      - Otherwise try UUID prefix match; filtered list first, then full list
    """
    sessions = find_sessions(max_age_days=max_age_days)

    # Explicit list index with # prefix
    force_index = identifier.startswith("#")
    if force_index:
        identifier = identifier[1:]

    # Try as list index
    try:
        idx = int(identifier) - 1
        if 0 <= idx < len(sessions):
            return sessions[idx]["path"]
    except ValueError:
        pass

    if force_index:
        return None

    # Remote-control IDs: accept 'cse_<X>' as well as 'session_<X>'
    if identifier.startswith("cse_"):
        identifier = "session_" + identifier[len("cse_"):]

    def id_matches(s):
        return (s["session_id"].startswith(identifier)
                or any(r.startswith(identifier) for r in s["remote_ids"]))

    # Search by session ID (prefix match) — filtered list first
    matches = [s for s in sessions if id_matches(s)]
    if not matches and max_age_days is not None:
        # Widen the search to all sessions for ID prefix lookup
        matches = [s for s in find_sessions() if id_matches(s)]
    if len(matches) == 1:
        return matches[0]["path"]
    elif len(matches) > 1:
        print(f"Ambiguous UUID prefix '{identifier}' matches {len(matches)} sessions:")
        for s in matches:
            print(f"  {s['session_id']}")
        print("Provide more characters to disambiguate.")
        sys.exit(1)

    return None


def format_content_block(block, show_thinking, show_tools, compact):
    """Format a single content block for display."""
    if not isinstance(block, dict):
        return str(block)

    btype = block.get("type", "")

    if btype == "thinking":
        if not show_thinking:
            return None
        thinking = block.get("thinking", "")
        if not thinking:
            return None
        if compact:
            lines = thinking.strip().split("\n")
            preview = lines[0][:120]
            if len(lines) > 1 or len(lines[0]) > 120:
                preview += f" {DIM}[...{len(thinking)} chars]{RESET}"
            return f"{THINKING_COLOR}  [thinking] {preview}{RESET}"
        wrapped = textwrap.indent(thinking.strip(), "  ")
        return f"{THINKING_COLOR}  [thinking]\n{wrapped}{RESET}"

    elif btype == "text":
        text = block.get("text", "")
        if not text:
            return None
        return textwrap.indent(text.strip(), "  ")

    elif btype == "tool_use":
        if not show_tools:
            return None
        name = block.get("name", "unknown")
        inp = block.get("input", {})
        # Format tool input concisely
        parts = []
        for k, v in inp.items():
            sv = str(v)
            if compact and len(sv) > 100:
                sv = sv[:100] + "..."
            parts.append(f"{k}={sv}")
        args = ", ".join(parts)
        if compact and len(args) > 200:
            args = args[:200] + "..."
        return f"{TOOL_COLOR}  [{name}] {args}{RESET}"

    elif btype == "tool_result":
        if not show_tools:
            return None
        content = block.get("content", "")
        is_error = block.get("is_error", False)
        color = ERROR_COLOR if is_error else TOOL_RESULT_COLOR
        prefix = "ERROR" if is_error else "result"

        if isinstance(content, list):
            # Extract text from content blocks
            text_parts = []
            for sub in content:
                if isinstance(sub, dict) and sub.get("type") == "text":
                    text_parts.append(sub.get("text", ""))
            content = "\n".join(text_parts)

        if not content:
            return f"{color}  [{prefix}] (empty){RESET}"

        if compact:
            lines = content.strip().split("\n")
            if len(lines) > 3:
                preview = "\n".join(lines[:3])
                preview = textwrap.indent(preview, "    ")
                return f"{color}  [{prefix}] ({len(lines)} lines)\n{preview}\n    ...{RESET}"
            else:
                preview = textwrap.indent(content.strip(), "    ")
                return f"{color}  [{prefix}]\n{preview}{RESET}"
        else:
            formatted = textwrap.indent(content.strip(), "    ")
            return f"{color}  [{prefix}]\n{formatted}{RESET}"

    return None


def render_session(path, show_thinking=True, show_tools=True, compact=False, verbose=False):
    """Render a full session conversation."""
    with open(path) as f:
        entries = []
        for line in f:
            try:
                entries.append(json.loads(line))
            except (json.JSONDecodeError, ValueError):
                continue

    if not entries:
        print("Empty session file.")
        return

    # Group assistant lines by requestId to merge streaming chunks
    request_groups = defaultdict(list)
    ordered_items = []  # (timestamp, type, data)

    for entry in entries:
        if not isinstance(entry, dict):
            continue
        etype = entry.get("type")
        if etype not in ("user", "assistant"):
            continue

        msg = entry.get("message", {})
        if not isinstance(msg, dict):
            continue

        role = msg.get("role")
        ts = parse_timestamp(entry.get("timestamp"))

        if role == "assistant":
            rid = entry.get("requestId", id(entry))
            request_groups[rid].append(entry)
            # Only add on first occurrence
            if len(request_groups[rid]) == 1:
                ordered_items.append((ts, "assistant_group", rid))
        elif role == "user":
            ordered_items.append((ts, "user", entry))

    # Get session metadata
    session_id = entries[0].get("sessionId", "") if entries else ""
    for e in entries:
        if isinstance(e, dict) and e.get("sessionId"):
            session_id = e["sessionId"]
            break

    print(f"\n{BOLD}Session: {session_id}{RESET}")
    print(f"{SEPARATOR_COLOR}{'=' * 80}{RESET}\n")

    msg_num = 0
    for ts, item_type, data in ordered_items:
        time_str = datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S") if ts else ""

        if item_type == "user":
            msg = data.get("message", {})
            content = msg.get("content", "")

            # Skip tool_result entries displayed inline
            if isinstance(content, list):
                has_tool_result = any(
                    isinstance(b, dict) and b.get("type") == "tool_result"
                    for b in content
                )
                if has_tool_result:
                    for block in content:
                        rendered = format_content_block(block, show_thinking, show_tools, compact)
                        if rendered:
                            print(rendered)
                    continue

            msg_num += 1
            print(f"{USER_COLOR}USER{RESET} {DIM}[{time_str}]{RESET}")
            if isinstance(content, str):
                print(textwrap.indent(content.strip(), "  "))
            elif isinstance(content, list):
                for block in content:
                    rendered = format_content_block(block, show_thinking, show_tools, compact)
                    if rendered:
                        print(rendered)
            print()

        elif item_type == "assistant_group":
            rid = data
            group = request_groups[rid]
            if not group:
                continue

            first_ts = parse_timestamp(group[0].get("timestamp"))
            time_str = datetime.fromtimestamp(first_ts).strftime("%Y-%m-%d %H:%M:%S") if first_ts else ""

            model = ""
            for entry in group:
                m = entry.get("message", {}).get("model", "")
                if m:
                    model = m
                    break

            model_tag = f" ({model})" if model else ""
            print(f"{ASSISTANT_COLOR}ASSISTANT{model_tag}{RESET} {DIM}[{time_str}]{RESET}")

            for entry in group:
                msg = entry.get("message", {})
                content = msg.get("content", [])
                if isinstance(content, list):
                    for block in content:
                        rendered = format_content_block(block, show_thinking, show_tools, compact)
                        if rendered:
                            print(rendered)
                elif isinstance(content, str) and content.strip():
                    print(textwrap.indent(content.strip(), "  "))

            # Show usage summary when requested
            if verbose:
                last_entry = group[-1]
                usage = last_entry.get("message", {}).get("usage", {})
                if usage:
                    inp = usage.get("input_tokens", 0)
                    out = usage.get("output_tokens", 0)
                    cache_r = usage.get("cache_read_input_tokens", 0)
                    cache_c = usage.get("cache_creation_input_tokens", 0)
                    print(f"{DIM}  [tokens: in={inp:,} out={out:,} cache_read={cache_r:,} cache_create={cache_c:,}]{RESET}")

            print()

    print(f"{SEPARATOR_COLOR}{'=' * 80}{RESET}")
    print(f"{DIM}End of session{RESET}\n")


def main():
    # Exit quietly when piped into head/less and the reader closes early
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    args = sys.argv[1:]
    color = None  # the last --color/--no-color wins
    for a in args:
        if a == "--color":
            color = True
        elif a == "--no-color":
            color = False
    if color is not None:
        set_color(color)

    show_thinking = True
    show_tools = True
    compact = False
    verbose = False
    info_mode = False
    max_age_days = 3  # default window for listing

    if "--help" in args or "-h" in args:
        print(f"""{BOLD}claude-session{RESET} — Reconstruct Claude Code conversations from local session files

{BOLD}USAGE{RESET}
  claude-session [-v] [-d N | --all]      List recent sessions (last 3 days)
  claude-session <session> [options]      Replay the full conversation
  claude-session <session> -i [-v]        Show a summary of the session

{BOLD}SESSION IDENTIFIER{RESET}
  N                   Session number from the list (e.g. 3)
  <uuid>              Full or partial session UUID
  session_<id>        Full or partial Remote Control session ID (cse_<id> also works)
  <path>              Direct path to a .jsonl file (e.g. for subagents)

  A bare number within the session list range is treated as a list index.
  Larger numbers or strings with non-digit characters are treated as UUID
  prefixes. If a prefix matches multiple sessions, you'll be prompted to
  provide more characters.

{BOLD}OPTIONS{RESET}
  -d N, --days N      Show sessions updated in the last N days (default: 3)
  --all               Show all sessions regardless of age
  -v, --verbose       Show Remote Control session IDs and token usage in the
                      list, per-response token counts in replay, and token
                      usage plus untruncated lists in --info
  -i, --info          Show session details instead of replaying it: title,
                      directory, branch, worktree, timeline, models, tool and
                      skill usage, files modified, PRs, subagents
  --no-thinking       Hide thinking/reasoning blocks
  --no-tools          Hide tool calls and tool results
  --compact           Hide thinking + truncate tool results to 3 lines
  --color, --no-color Force colors on/off (default: on only for a terminal,
                      off if NO_COLOR is set). Use --color with less -R.
  -h, --help          Show this help message

{BOLD}ENVIRONMENT{RESET}
  CLAUDE_CONFIG_DIR   Claude Code data directory (default: ~/.claude)
  NO_COLOR            Disable colors when set

{BOLD}EXAMPLES{RESET}
  claude-session                          List sessions from the last 3 days
  claude-session --days 14                List sessions from the last 14 days
  claude-session --all                    List every session on disk
  claude-session -v                       List sessions with token usage
  claude-session 1                        Replay the most recent session
  claude-session 1 --compact              Same, but condensed output
  claude-session 1 --no-tools             Just the conversation text and thinking
  claude-session a8359a07                 Look up session by UUID prefix
  claude-session 1 --info                 Summarize the most recent session
  claude-session 1 -i -v                  Same, with token usage and full lists
""")
        return

    positional = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--color", "--no-color"):
            pass  # handled above
        elif a in ("-v", "--verbose"):
            verbose = True
        elif a in ("-i", "--info"):
            info_mode = True
        elif a == "--no-thinking":
            show_thinking = False
        elif a == "--no-tools":
            show_tools = False
        elif a == "--compact":
            show_thinking = False
            compact = True
        elif a == "--all":
            max_age_days = None
        elif a in ("-d", "--days"):
            if i + 1 >= len(args):
                print(f"Missing value for {a}", file=sys.stderr)
                sys.exit(1)
            i += 1
            try:
                n = int(args[i])
            except ValueError:
                print(f"--days expects an integer, got: {args[i]}", file=sys.stderr)
                sys.exit(1)
            if n < 0:
                print("--days must be >= 0", file=sys.stderr)
                sys.exit(1)
            max_age_days = None if n == 0 else n
        elif a.startswith("--days="):
            try:
                n = int(a.split("=", 1)[1])
            except ValueError:
                print(f"--days expects an integer, got: {a}", file=sys.stderr)
                sys.exit(1)
            if n < 0:
                print("--days must be >= 0", file=sys.stderr)
                sys.exit(1)
            max_age_days = None if n == 0 else n
        elif a.startswith("-"):
            print(f"Unknown option: {a}", file=sys.stderr)
            sys.exit(1)
        else:
            positional.append(a)
        i += 1

    if not positional:
        if info_mode:
            print("--info requires a session identifier.", file=sys.stderr)
            sys.exit(1)
        list_sessions(max_age_days=max_age_days, verbose=verbose)
        return

    identifier = positional[0]
    if identifier.endswith(".jsonl") and os.path.isfile(identifier):
        path = os.path.abspath(identifier)
    else:
        path = find_session_path(identifier, max_age_days=max_age_days)
    if not path:
        print(f"Session not found: {identifier}")
        print("Run claude-session with no arguments to list sessions.")
        sys.exit(1)

    if info_mode:
        show_session_info(path, verbose=verbose)
        return

    # Check for subagents
    session_dir = path.replace(".jsonl", "")
    subagent_dir = os.path.join(session_dir, "subagents")
    if os.path.isdir(subagent_dir):
        subagents = glob.glob(os.path.join(glob.escape(subagent_dir), "*.jsonl"))
        if subagents:
            print(f"{DIM}Note: This session has {len(subagents)} subagent conversation(s).{RESET}")
            print(f"{DIM}View them with: claude-session <path-to-subagent.jsonl>{RESET}\n")

    render_session(path, show_thinking, show_tools, compact, verbose)


if __name__ == "__main__":
    main()
