#!/usr/bin/env python3
"""Show Claude Code tool and command usage aggregated from local session files."""

import json
import os
import glob
from collections import Counter

# Claude Code's data directory; honors CLAUDE_CONFIG_DIR like Claude Code does.
CLAUDE_DIR = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")


def read_jsonl(path):
    """Yield each JSON object in a JSONL file, skipping malformed lines.

    A bad line never stops the rest of the file from being read; an
    unreadable or missing file yields nothing.
    """
    try:
        with open(path, errors="replace") as f:
            for line in f:
                try:
                    data = json.loads(line)
                except ValueError:
                    continue
                if isinstance(data, dict):
                    yield data
    except OSError:
        return


def main():
    projects_dir = os.path.join(CLAUDE_DIR, "projects")
    history_path = os.path.join(CLAUDE_DIR, "history.jsonl")

    # Slash commands from history
    slash_cmds = Counter()
    for data in read_jsonl(history_path):
        display = data.get("display")
        if isinstance(display, str) and display.startswith("/"):
            slash_cmds[display.strip().split()[0]] += 1

    # Tool invocations from session files
    tool_counts = Counter()
    skill_counts = Counter()
    pattern = os.path.join(glob.escape(projects_dir), "**", "*.jsonl")
    for jsonl_path in glob.glob(pattern, recursive=True):
        for data in read_jsonl(jsonl_path):
            # Only real assistant turns; api-request-blob entries also carry
            # a "message" (a copy of the request) and would double-count
            # earlier tool calls.
            if data.get("type") != "assistant":
                continue
            msg = data.get("message")
            content = msg.get("content") if isinstance(msg, dict) else None
            if not isinstance(content, list):
                continue
            for block in content:
                if not isinstance(block, dict) or block.get("type") != "tool_use":
                    continue
                name = block.get("name") or "unknown"
                tool_counts[name] += 1
                if name == "Skill":
                    inp = block.get("input")
                    skill = inp.get("skill") if isinstance(inp, dict) else None
                    skill_counts[skill or "unknown"] += 1

    # Print slash commands
    print("\nSlash commands (user-typed):")
    print("-" * 35)
    if slash_cmds:
        for cmd, count in slash_cmds.most_common():
            print(f"  {cmd:<20} {count:>6}")
    else:
        print("  (none found)")

    # Print skill invocations
    print("\nSkill invocations:")
    print("-" * 35)
    if skill_counts:
        for skill, count in skill_counts.most_common():
            print(f"  {skill:<20} {count:>6}")
    else:
        print("  (none found)")

    # Print tool usage
    print("\nTool usage (all sessions):")
    print("-" * 35)
    if tool_counts:
        for tool, count in tool_counts.most_common():
            print(f"  {tool:<35} {count:>6}")
    else:
        print("  (none found)")

    print(f"\n  Total tool calls: {sum(tool_counts.values()):,}")


if __name__ == "__main__":
    main()
